APP_URL=https://sickcatsurvival.com
# The app generates and saves a local auth secret when this is omitted.
# Set a stable secret explicitly when running multiple instances.
# BETTER_AUTH_SECRET=your-long-random-secret

STRIPE_SECRET_KEY=sk_live_replace_with_existing_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_existing_signing_secret

# Optional existing monthly Prices. Otherwise the app creates the three offers
# through Stripe on first use: $1, $5, $10 per month.
# STRIPE_PRICE_FIELD_NOTES=price_...
# STRIPE_PRICE_EMERGENCY_DESK=price_...
# STRIPE_PRICE_ARCHIVE=price_...
# STRIPE_PORTAL_CONFIGURATION=bpc_...

# Default: persistent embedded Postgres in .data/pglite, for one Node process.
# APP_DATA_DIR=/persistent/sick-cat
# PGLITE_DATA_DIR=/persistent/sick-cat/database
# Optional external Postgres. Apply migrations with npm run db:migrate.
# DATABASE_URL=postgresql://user:password@host/database

# Optional merchandise fulfillment. Supply real published product and variant IDs.
# PRINTIFY_API_TOKEN=your-token
# PRINTIFY_SHOP_ID=your-shop-id
# PRINTIFY_PRODUCTS_JSON={"field-tee":{"product_id":"your-product-id","variant_id":123}}
